# MeetingMind Backend Configuration

# OpenAI API Key for AI-powered summaries and action item extraction
OPENAI_API_KEY=sk-your-openai-api-key

# Otter.ai Credentials
OTTER_EMAIL=your-email@example.com
OTTER_PASSWORD=your-otter-password

# Notion Integration
NOTION_API_KEY=secret_your-notion-api-key
NOTION_DATABASE_ID=your-notion-database-id

# Zapier Webhook URLs
ZAPIER_WEBHOOK_SUMMARY=https://hooks.zapier.com/hooks/catch/your-summary-webhook
ZAPIER_WEBHOOK_ACTION_ITEMS=https://hooks.zapier.com/hooks/catch/your-action-items-webhook
ZAPIER_WEBHOOK_FOLLOWUP=https://hooks.zapier.com/hooks/catch/your-followup-webhook

# Application Settings
DATABASE_URL=sqlite+aiosqlite:///./meetingmind.db
SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
